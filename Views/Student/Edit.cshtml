@model Student

<div id="validation">

</div>

<form asp-controller="Student" asp-action="Update" method="post" class="form">
    <div asp-validation-summary="All" style="color: red"></div>

        <input asp-for="Id" class="form-control" type="hidden" value="@Model?.Id" />
    <div>
        <label>Name</label>
        <input asp-for="Name" class="form-control" value="@Model?.Name" />
    </div>
    <div>
        <label>Age</label>
        <input asp-for="Age" class="form-control" value="@Model?.Age" />
    </div>
    <div>
        <label>Grade</label>
        <input asp-for="Grade" class="form-control" value="@Model?.Grade" />
    </div>
    <button type="submit" class="btn btn-success mt-3">Save</button>
</form>

<div id="student">

</div>

@section Scripts{
    <script>
        const edit = AddOperation("student", "validation");

        AjaxRequest("form", "submit", edit, "POST" , false);
    </script>
}