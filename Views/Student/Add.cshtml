@model Student

<div id="validation"></div>

<form asp-controller="Student" asp-action="Save" method="post" class="form">
    <div>
        <label>Name</label>
        <input asp-for="Name" class="form-control" value="@Model?.Name" />
    </div>
    <div>
        <label>Age</label>
        <input asp-for="Age" class="form-control" value="@Model?.Age" />
    </div>
    <div>
        <label>Grade</label>
        <input asp-for="Grade" class="form-control" value="@Model?.Grade" />
    </div>
    <button type="submit" class="btn btn-success mb-3 mt-3">Add</button>
</form>




<div id="student">

</div>



@section Scripts{
    
    <script>
        
        $(".form").on("submit", function(event) {
            event.preventDefault();

            $.ajax({
                url : $(this).attr("action"),
                method : "POST",
                data: $(this).serialize(),
                success: function(response){
                    
                    const student = $(response).filter(".student");
                    const validation = $(response).filter(".validation");

                    $("#student").html(student);
                    $("#validation").html(validation);
                }
            });
        });

    </script>
}