<h1>Search</h1>

<div id="validation">

</div>

<form asp-controller="Student" asp-action="SearchResult" method="get" class="form">

    
    

    <!-- Name -->
    <label class="form-label">Name</label>
    <div class="mb-2">
        <input name="Name" type="text" class="form-control mt-2" />
    </div>

    <!-- Age -->
    <label class="form-label">Age</label>
    <div class="d-flex gap-2 ">
        <input name="AgeFrom" type="number" class="form-control mb-2 mt-2" placeholder="From" />
        <input name="AgeTo" type="number" class="form-control mb-2 mt-2" placeholder="To" />
    </div>

    <!-- Grade -->
    <label class="form-label">Grade</label>
    <div class="d-flex gap-2 ">
        <input name="GradeFrom" type="number" class="form-control mb-2 mt-2" placeholder="From" />
        <input name="GradeTo" type="number" class="form-control mb-2 mt-2" placeholder="To" />
    </div>

    <!-- Sort -->
    <label class="form-label">Sort By:</label>
    <div class="d-flex gap-2 ">
        <select name="SortBy" class="form-select mb-2 mt-2">
            <option value="" selected disabled>Choose sorting option...</option>
            <option value="Id">Id</option>
            <option value="Name">Name</option>
            <option value="Age">Age</option>
            <option value="Grade">Grade</option>
        </select>
    </div>

    <!-- Buttons -->
    <div class="d-flex gap-2 ">
        <button type="submit" class="btn btn-success mb-3 mt-3">Search</button>
        <a asp-controller="Student" asp-action="Search" class="btn btn-primary">Clear</a>
    </div>

</form>

<div id="Studentlist">
</div>

<div id="Pagination">
</div>

<div id="details">

</div>

<div id="confirmdelete">

</div>

@section Scripts {
    <script>

        $(".form").on("submit" , function(event){

            event.preventDefault();

            $.ajax({
                url: $(this).attr("action"),
                method: "GET",
                data:
                    $(this).serialize(),
                success: function(response){

                    const studentlist = $(response).filter("#studentlist1");
                    const pagination = $(response).filter("#Pagination1");
                    const validation = $(response).filter(".newvalidation");

                    $("#Studentlist").html(studentlist);
                    $("#Pagination").html(pagination);
                    $("#validation").html(validation);
                }
            });
        });


        $("#Pagination").on("click", ".pagination-link", function(event) {
            event.preventDefault();

            $.ajax({
                url: $(this).attr("href"),
                method: "GET",
                success: function(response){

                    const newstudentlist = $(response).filter("#studentlist1");
                    const newpagination = $(response).filter("#Pagination1");

                    $("#Studentlist").html(newstudentlist);
                    $("#Pagination").html(newpagination);
                }
            });
        });

        $("#Studentlist").on("click", ".Details", function(event) {
            event.preventDefault();

            $.ajax({
                url: $(this).attr("href"),
                method: "GET",
                success: function(response){
                    $("#details").html(response);
                }
            });
        });

        $("#Studentlist").on("click", ".Delete", function(event) {
            event.preventDefault();

            $.ajax({
                url: $(this).attr("href"),
                method: "GET",
                success: function(response) {
                    $("#confirmdelete").html(response);
                }
            });
        });
        
    </script>
}