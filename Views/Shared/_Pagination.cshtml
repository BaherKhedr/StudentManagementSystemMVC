@model PaginationViewModel

<nav aria-label="Page navigation example" class="pagination-container">
    <ul class="pagination">
        @if(Model.CurrentPage > 1)
        {
            <li class="page-item"><a asp-controller="Student" asp-action="Pagination" asp-route-CurrentPage="@(Model.CurrentPage - 1)" class="page-link pagination-link">Previous</a></li>
        }
        @for(int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item"><a asp-controller="Student" asp-action="Pagination" asp-route-CurrentPage="@i" class="page-link pagination-link">@i</a></li>
        }
        
        @if(Model.CurrentPage < Model.TotalPages)
        {
            <li class="page-item"><a asp-controller="Student" asp-action="Pagination" asp-route-CurrentPage="@(Model.CurrentPage + 1)" class="page-link pagination-link">Next</a></li>
        }

    </ul>
</nav>